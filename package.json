{
  "name": "recomp-landing",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n css,web -c cyan,magenta \"npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch\" \"python3 -m http.server 3000\"",
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
